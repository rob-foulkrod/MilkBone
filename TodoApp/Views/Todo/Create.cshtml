@model TodoApp.Models.TodoItem
@{
    ViewData["Title"] = "New Todo";
}

<div class="page-header">
    <h1>✏️ New Todo</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">← Back</a>
</div>

<div class="mb-form-card">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" style="display:none" id="val-summary"></div>
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="Title" class="form-label">Title <span class="text-danger">*</span></label>
            <input asp-for="Title" class="form-control" placeholder="What needs to be done?" autofocus />
            <span asp-validation-for="Title" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3"
                      placeholder="Add more details (optional)…"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-sm-6">
                <label asp-for="Priority" class="form-label">Priority</label>
                <select asp-for="Priority" class="form-select"
                        asp-items="Html.GetEnumSelectList<TodoApp.Models.TodoPriority>()"></select>
            </div>
            <div class="col-sm-6">
                <label asp-for="DueDate" class="form-label">Due Date</label>
                <input asp-for="DueDate" type="date" class="form-control" />
                <span asp-validation-for="DueDate" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Add Todo</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Show validation summary only if it has content
        const vs = document.getElementById('val-summary');
        if (vs && vs.querySelector('li')) vs.style.display = '';
    </script>
}
