@model TodoApp.Models.TodoItem
@{
    ViewData["Title"] = "Todo Details";
    var today = DateTime.UtcNow.Date;
    var priorityClass = Model.Priority.ToString().ToLower();
    var isOverdue = !Model.IsCompleted && Model.DueDate.HasValue && Model.DueDate.Value.Date < today;
}

<div class="page-header">
    <h1>📋 Todo Details</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">← Back</a>
</div>

<div class="detail-card">
    <div class="d-flex align-items-start justify-content-between mb-3">
        <div>
            <h2 class="@(Model.IsCompleted ? "text-decoration-line-through text-muted" : "")">@Model.Title</h2>
            <div class="d-flex gap-2 flex-wrap mt-1">
                <span class="badge-priority badge-@priorityClass">@Model.Priority</span>
                @if (Model.IsCompleted)
                {
                    <span class="badge-due" style="background:#f0fdf4;color:#166534;">✅ Completed</span>
                }
                else if (isOverdue)
                {
                    <span class="badge-due overdue">⚠️ Overdue</span>
                }
                else
                {
                    <span class="badge-due">🔵 Active</span>
                }
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <p class="text-muted mb-4" style="white-space:pre-wrap">@Model.Description</p>
    }

    <dl class="row">
        <dt class="col-sm-4">Created</dt>
        <dd class="col-sm-8">@Model.CreatedAt.ToString("MMMM d, yyyy h:mm tt") UTC</dd>

        @if (Model.DueDate.HasValue)
        {
            <dt class="col-sm-4">Due Date</dt>
            <dd class="col-sm-8 @(isOverdue ? "text-danger fw-bold" : "")">
                @Model.DueDate.Value.ToString("MMMM d, yyyy")
                @if (isOverdue) { <span>(Overdue!)</span> }
            </dd>
        }

        @if (Model.CompletedAt.HasValue)
        {
            <dt class="col-sm-4">Completed</dt>
            <dd class="col-sm-8">@Model.CompletedAt.Value.ToString("MMMM d, yyyy h:mm tt") UTC</dd>
        }
    </dl>

    <div class="d-flex gap-2 mt-4">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">✏️ Edit</a>
        <form asp-action="Toggle" asp-route-id="@Model.Id" method="post" style="margin:0">
            <input type="hidden" name="returnFilter" value="all" />
            <button type="submit" class="btn btn-outline-secondary">
                @(Model.IsCompleted ? "↩ Mark Active" : "✓ Mark Complete")
            </button>
        </form>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger ms-auto">🗑️ Delete</a>
    </div>
</div>
